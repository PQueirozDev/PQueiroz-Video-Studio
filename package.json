{
  "name": "pqueiroz-video-studio",
  "productName": "PQueiroz Video Studio",
  "version": "0.2.1",
  "description": "Central de edição de vídeos assistida por IA: projetos, preview, versões e render, com o Claude Code usando o seu fluxo de edição.",
  "author": "Pedro Queiroz",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder --win --x64 --publish never",
    "dist:dir": "electron-vite build && electron-builder --win dir",
    "icons": "node scripts/generate-icons.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "cmdk": "^1.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.51.0",
    "png-to-ico": "^3.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.14.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^7.3.6",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "com.pqueiroz.videostudio.desktop",
    "productName": "PQueiroz Video Studio",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "PQueiroz-Video-Studio-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PQueiroz Video Studio",
      "guid": "022b7b7a-69d5-56cc-b771-935b23c23d1d"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "PQueirozDev",
        "repo": "PQueiroz-Video-Studio",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PQueirozDev/PQueiroz-Video-Studio.git"
  },
  "homepage": "https://pqueirozdev.github.io/PQueiroz-Video-Studio",
  "license": "MIT"
}
